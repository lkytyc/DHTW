{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Fer Process Schema",
    "type": "object",
    "properties": {
        "extractionUnit": {
            "type": "object",
            "description": "Represents a single chunk of filing text from which facts are extracted.",
            "properties": {
                "chunkText": {
                    "type": "string",
                    "description": "The text of the chunk from the corporate filing."
                },
                "facts": {
                    "type": "array",
                    "description": "List of extracted facts represented as triples. May be empty.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "subjectEntity": {
                                "type": "object",
                                "description": "The subject entity in the triple.",
                                "properties": {
                                    "surfaceName": {
                                        "type": "string"
                                    },
                                    "entityType": {
                                        "type": "string",
                                        "description": "Canonical entity type label. Use a stable, canonical set (avoid synonyms)."
                                    },
                                    "mappedType": {
                                        "type": "string",
                                        "description": "Optional field to map entityType to a benchmark inventory."
                                    }
                                },
                                "required": [
                                    "surfaceName",
                                    "entityType"
                                ]
                            },
                            "relation": {
                                "type": "object",
                                "description": "The relation connecting the subject and object entities.",
                                "properties": {
                                    "relationLabel": {
                                        "type": "string",
                                        "description": "Canonical relation label. Use a stable, canonical set."
                                    },
                                    "mappedRelation": {
                                        "type": "string",
                                        "description": "Optional field to map relationLabel to a benchmark inventory."
                                    }
                                },
                                "required": [
                                    "relationLabel"
                                ]
                            },
                            "objectEntity": {
                                "type": "object",
                                "description": "The object entity in the triple.",
                                "properties": {
                                    "surfaceName": {
                                        "type": "string"
                                    },
                                    "entityType": {
                                        "type": "string",
                                        "description": "Canonical entity type label. Use a stable, canonical set (avoid synonyms)."
                                    },
                                    "mappedType": {
                                        "type": "string",
                                        "description": "Optional field to map entityType to a benchmark inventory."
                                    }
                                },
                                "required": [
                                    "surfaceName",
                                    "entityType"
                                ]
                            },
                            "evidence": {
                                "type": "object",
                                "description": "Evidence grounding for the extracted triple.",
                                "properties": {
                                    "evidencePhrase": {
                                        "type": "string"
                                    },
                                    "characterSpans": {
                                        "type": "array",
                                        "description": "Character-offset spans within chunkText.",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "start": {
                                                    "type": "integer"
                                                },
                                                "end": {
                                                    "type": "integer"
                                                }
                                            },
                                            "required": [
                                                "start",
                                                "end"
                                            ]
                                        }
                                    }
                                }
                            },
                            "temporalInformation": {
                                "type": "object",
                                "description": "Temporal information related to the triple.",
                                "properties": {
                                    "startDate": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "endDate": {
                                        "type": "string",
                                        "format": "date"
                                    }
                                }
                            }
                        },
                        "required": [
                            "subjectEntity",
                            "relation",
                            "objectEntity"
                        ]
                    },
                    "default": []
                }
            },
            "required": [
                "chunkText"
            ]
        },
        "documentMetadata": {
            "type": "object",
            "description": "Metadata related to the corporate filing document.",
            "properties": {
                "companyIdentifier": {
                    "type": "string"
                },
                "filingYear": {
                    "type": "integer"
                },
                "filingPeriod": {
                    "type": "string"
                },
                "sectionContext": {
                    "type": "string"
                }
            },
            "required": [
                "companyIdentifier",
                "filingYear"
            ]
        }
    },
    "required": [
        "extractionUnit",
        "documentMetadata"
    ]
}